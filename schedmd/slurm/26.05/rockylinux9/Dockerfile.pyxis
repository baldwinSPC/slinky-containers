ARG REGISTRY=ghcr.io/slinkyproject
# Empty resolves the latest GitHub release at build time.
ARG ENROOT_VERSION=""
ARG PYXIS_VERSION=""
# Empty installs the latest nvidia-container-toolkit; a version such as
# 1.20.1-1 pins the toolkit and the libnvidia-container packages it requires.
ARG NVIDIA_CONTAINER_TOOLKIT_VERSION=""

################################################################################
# Replaced by a named build context holding SHA256SUMS to verify the downloads.
FROM scratch AS checksums

################################################################################
FROM ${REGISTRY}/slurmd:26.05-rockylinux9 AS download

SHELL ["bash", "-c"]

ARG TARGETARCH
ARG ENROOT_VERSION
ARG PYXIS_VERSION

USER root
WORKDIR /tmp/

RUN --mount=type=cache,target=/var/cache/dnf,sharing=locked \
  --mount=type=bind,from=checksums,target=/checksums/ <<EOR
# Download Versions
set -xeuo pipefail
dnf -q -y update
dnf -q -y install --setopt='install_weak_deps=False' \
  ca-certificates curl-minimal wget
# Determine Latest Versions
latest_github_release() {
  local repo="$1"
  local url
  local tag
  if ! url="$(
    curl -fsSLI \
      --retry 5 \
      --retry-all-errors \
      --retry-delay 2 \
      --connect-timeout 15 \
      --max-time 60 \
      -o /dev/null \
      -w '%{url_effective}' \
      "https://github.com/NVIDIA/${repo}/releases/latest"
  )"; then
    echo "failed to resolve latest ${repo} release" >&2
    return 1
  fi
  tag="${url##*/}"
  tag="${tag#v}"
  if [[ -z "${tag}" || "${tag}" == "latest" || ! "${tag}" =~ ^[0-9][0-9A-Za-z._-]*$ ]]; then
    echo "failed to extract latest ${repo} release tag from ${url}" >&2
    return 1
  fi
  printf '%s\n' "${tag}"
}
ENROOT_VERSION="${ENROOT_VERSION:-$(latest_github_release enroot)}"
PYXIS_VERSION="${PYXIS_VERSION:-$(latest_github_release pyxis)}"
# Determine ARCH
ARCH=${TARGETARCH}
case ${TARGETARCH} in
amd64) ARCH=x86_64 ;;
arm64) ARCH=aarch64 ;;
esac
# Download
wget -N https://github.com/NVIDIA/enroot/releases/download/v${ENROOT_VERSION}/enroot-${ENROOT_VERSION}-1.el8.${ARCH}.rpm
wget -N https://github.com/NVIDIA/enroot/releases/download/v${ENROOT_VERSION}/enroot+caps-${ENROOT_VERSION}-1.el8.${ARCH}.rpm
wget -N -O /usr/share/bash-completion/completions/enroot https://raw.githubusercontent.com/NVIDIA/enroot/refs/tags/v${ENROOT_VERSION}/conf/bash_completion
wget -N -P /etc/enroot/hooks.d/ \
  https://raw.githubusercontent.com/NVIDIA/enroot/refs/tags/v${ENROOT_VERSION}/conf/hooks/extra/50-mig-config.sh \
  https://raw.githubusercontent.com/NVIDIA/enroot/refs/tags/v${ENROOT_VERSION}/conf/hooks/extra/50-sharp.sh \
  https://raw.githubusercontent.com/NVIDIA/enroot/refs/tags/v${ENROOT_VERSION}/conf/hooks/extra/50-slurm-pmi.sh \
  https://raw.githubusercontent.com/NVIDIA/enroot/refs/tags/v${ENROOT_VERSION}/conf/hooks/extra/50-slurm-pytorch.sh
chmod 755 -R /etc/enroot/hooks.d/
wget -N -O pyxis.tar.gz https://github.com/NVIDIA/pyxis/archive/refs/tags/v${PYXIS_VERSION}.tar.gz
# Verify
if [ -f /checksums/SHA256SUMS ]; then
  DOWNLOADS=(
    "tmp/enroot-${ENROOT_VERSION}-1.el8.${ARCH}.rpm"
    "tmp/enroot+caps-${ENROOT_VERSION}-1.el8.${ARCH}.rpm"
    "tmp/pyxis.tar.gz"
    "usr/share/bash-completion/completions/enroot"
    "etc/enroot/hooks.d/50-mig-config.sh"
    "etc/enroot/hooks.d/50-sharp.sh"
    "etc/enroot/hooks.d/50-slurm-pmi.sh"
    "etc/enroot/hooks.d/50-slurm-pytorch.sh"
  )
  for f in "${DOWNLOADS[@]}"; do
    if ! awk -v f="${f}" '$2 == f { found = 1 } END { exit !found }' /checksums/SHA256SUMS; then
      echo "no checksum for /${f} in SHA256SUMS" >&2
      exit 1
    fi
  done
  (cd / && sha256sum --check --strict --ignore-missing /checksums/SHA256SUMS)
fi
EOR

# Ref: https://github.com/NVIDIA/pyxis?tab=readme-ov-file#with-a-rpm-package
# Ref: https://github.com/NVIDIA/enroot/blob/master/doc/installation.md
RUN --mount=type=cache,target=/var/cache/dnf,sharing=locked <<EOR
# Generate Pyxis RPM
set -xeuo pipefail
dnf -q -y update
dnf -q -y install --setopt='install_weak_deps=False' \
  '@Development' \
  git gcc make libcap libtool automake libmd-devel \
  rpm-build 'dnf-command(builddep)' \
  tar
mkdir pyxis
tar -zxvf pyxis.tar.gz -C pyxis --strip-components=1
cd pyxis
make rpm
# make rpm writes under pyxis/rpm/RPMS/<arch>/, which the COPY of /tmp/*.rpm
# below does not reach.
find /tmp/pyxis/rpm/RPMS -name '*.rpm' -exec cp -t /tmp/ {} +
EOR

################################################################################
FROM ${REGISTRY}/slurmd:26.05-rockylinux9 AS slurmd-pyxis

ARG ENROOT_VERSION
ENV ENROOT_VERSION="${ENROOT_VERSION}"

ARG PYXIS_VERSION
ENV PYXIS_VERSION="${PYXIS_VERSION}"

ARG NVIDIA_CONTAINER_TOOLKIT_VERSION

COPY --from=download /tmp/*.rpm ./
COPY --from=download /etc/enroot/hooks.d/* /etc/enroot/hooks.d/
COPY --from=download /usr/share/bash-completion/completions/* /usr/share/bash-completion/completions/

# Ref: https://github.com/NVIDIA/pyxis?tab=readme-ov-file#with-a-rpm-package
# Ref: https://github.com/NVIDIA/enroot/blob/master/doc/installation.md
RUN --mount=type=cache,target=/var/cache/dnf,sharing=locked <<EOR
# Install Pyxis+Enroot
set -xeuo pipefail
rm -f *.src.rpm
dnf -q -y update
dnf -q -y install --setopt='install_weak_deps=False' \
  ca-certificates \
  bash-completion \
  fuse-overlayfs pigz squashfuse \
  ./*.rpm
rm *.rpm
for f in /usr/lib64/slurm/spank_pyxis.so /usr/share/pyxis/pyxis.conf; do
  if [ ! -f "${f}" ]; then
    echo "pyxis is not installed: ${f} is missing" >&2
    exit 1
  fi
done
# Configure
mkdir -m 777 -p /usr/share/enroot/enroot-data/
mkdir -m 755 -p /run/enroot/
mkdir -m 755 -p /etc/slurm/plugstack.conf.d/
ln -s /usr/share/pyxis/pyxis.conf /etc/slurm/plugstack.conf.d/pyxis.conf
EOR

COPY files/usr/local/entrypoint.d/90-mounts.sh /usr/local/entrypoint.d/

ADD https://nvidia.github.io/libnvidia-container/stable/rpm/nvidia-container-toolkit.repo /etc/yum.repos.d/nvidia-container-toolkit.repo

# Ref: https://docs.nvidia.com/datacenter/cloud-native/container-toolkit/latest/install-guide.html#with-dnf-rhel-centos-fedora-amazon-linux
RUN --mount=type=cache,target=/var/cache/dnf,sharing=locked <<EOR
# Install Nvidia Container Toolkit
set -xeuo pipefail
NVIDIA_CONTAINER_TOOLKIT_PACKAGES=(nvidia-container-toolkit)
if [ -n "${NVIDIA_CONTAINER_TOOLKIT_VERSION}" ]; then
  NVIDIA_CONTAINER_TOOLKIT_PACKAGES=(
    "nvidia-container-toolkit-${NVIDIA_CONTAINER_TOOLKIT_VERSION}"
    "nvidia-container-toolkit-base-${NVIDIA_CONTAINER_TOOLKIT_VERSION}"
    "libnvidia-container-tools-${NVIDIA_CONTAINER_TOOLKIT_VERSION}"
    "libnvidia-container1-${NVIDIA_CONTAINER_TOOLKIT_VERSION}"
  )
fi
dnf -q -y install --setopt='install_weak_deps=False' \
  "${NVIDIA_CONTAINER_TOOLKIT_PACKAGES[@]}"
EOR

################################################################################
FROM ${REGISTRY}/login:26.05-rockylinux9 AS login-pyxis

ARG ENROOT_VERSION
ENV ENROOT_VERSION="${ENROOT_VERSION}"

ARG PYXIS_VERSION
ENV PYXIS_VERSION="${PYXIS_VERSION}"

ARG NVIDIA_CONTAINER_TOOLKIT_VERSION

COPY --from=download /tmp/*.rpm ./
COPY --from=download /etc/enroot/hooks.d/* /etc/enroot/hooks.d/
COPY --from=download /usr/share/bash-completion/completions/* /usr/share/bash-completion/completions/

# Ref: https://github.com/NVIDIA/pyxis?tab=readme-ov-file#with-a-rpm-package
# Ref: https://github.com/NVIDIA/enroot/blob/master/doc/installation.md
RUN --mount=type=cache,target=/var/cache/dnf,sharing=locked <<EOR
# Install Pyxis+Enroot
set -xeuo pipefail
rm -f *.src.rpm
dnf -q -y update
dnf -q -y install --setopt='install_weak_deps=False' \
  ca-certificates \
  bash-completion \
  fuse-overlayfs pigz squashfuse \
  ./*.rpm
rm *.rpm
for f in /usr/lib64/slurm/spank_pyxis.so /usr/share/pyxis/pyxis.conf; do
  if [ ! -f "${f}" ]; then
    echo "pyxis is not installed: ${f} is missing" >&2
    exit 1
  fi
done
# Configure
mkdir -m 777 -p /usr/share/enroot/enroot-data/
mkdir -m 755 -p /run/enroot/
mkdir -m 755 -p /etc/slurm/plugstack.conf.d/
ln -s /usr/share/pyxis/pyxis.conf /etc/slurm/plugstack.conf.d/pyxis.conf
EOR

COPY files/usr/local/entrypoint.d/90-mounts.sh /usr/local/entrypoint.d/

ADD https://nvidia.github.io/libnvidia-container/stable/rpm/nvidia-container-toolkit.repo /etc/yum.repos.d/nvidia-container-toolkit.repo

# Ref: https://docs.nvidia.com/datacenter/cloud-native/container-toolkit/latest/install-guide.html#with-dnf-rhel-centos-fedora-amazon-linux
RUN --mount=type=cache,target=/var/cache/dnf,sharing=locked <<EOR
# Install Nvidia Container Toolkit
set -xeuo pipefail
NVIDIA_CONTAINER_TOOLKIT_PACKAGES=(nvidia-container-toolkit)
if [ -n "${NVIDIA_CONTAINER_TOOLKIT_VERSION}" ]; then
  NVIDIA_CONTAINER_TOOLKIT_PACKAGES=(
    "nvidia-container-toolkit-${NVIDIA_CONTAINER_TOOLKIT_VERSION}"
    "nvidia-container-toolkit-base-${NVIDIA_CONTAINER_TOOLKIT_VERSION}"
    "libnvidia-container-tools-${NVIDIA_CONTAINER_TOOLKIT_VERSION}"
    "libnvidia-container1-${NVIDIA_CONTAINER_TOOLKIT_VERSION}"
  )
fi
dnf -q -y install --setopt='install_weak_deps=False' \
  "${NVIDIA_CONTAINER_TOOLKIT_PACKAGES[@]}"
EOR
